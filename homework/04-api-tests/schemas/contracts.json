{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "status": {"enum": ["CREATED", "PAID", "COOKING", "OUT_FOR_DELIVERY", "DELIVERED", "CANCELLED"]},
    "address": {
      "type": "object", "additionalProperties": false,
      "required": ["city", "street", "house", "apartment", "postcode"],
      "properties": {
        "city": {"type": "string", "minLength": 1},
        "street": {"type": "string", "minLength": 1},
        "house": {"type": "string", "minLength": 1},
        "apartment": {"type": ["string", "null"]},
        "postcode": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "size", "qty"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "size": {"enum": ["SMALL", "MEDIUM", "LARGE"]},
        "qty": {"type": "integer", "minimum": 1}
      }
    },
    "order": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "address", "items", "status", "totalAmount", "currency", "deliveryZone", "cancellationReason"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "address": {"$ref": "#/$defs/address"},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
        "status": {"$ref": "#/$defs/status"},
        "totalAmount": {"type": "number", "exclusiveMinimum": 0},
        "currency": {"const": "EUR"},
        "deliveryZone": {"enum": ["CENTER", "OUTSKIRTS"]},
        "cancellationReason": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "totalAmount", "currency", "deliveryZone"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "status": {"$ref": "#/$defs/status"},
        "totalAmount": {"type": "number", "exclusiveMinimum": 0},
        "currency": {"const": "EUR"},
        "deliveryZone": {"enum": ["CENTER", "OUTSKIRTS"]}
      }
    },
    "orders": {"type": "array", "items": {"$ref": "#/$defs/summary"}},
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["timestamp", "status", "error", "message", "path"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "status": {"type": "integer", "minimum": 400, "maximum": 599},
        "error": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"}
      }
    },
    "board": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "currentStatus", "totalAmount", "currency", "deliveryZone", "paymentReceived", "cookingStarted", "courierAssigned", "delivered", "nextSuggestedCommand"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "currentStatus": {"$ref": "#/$defs/status"},
        "totalAmount": {"type": "number", "exclusiveMinimum": 0},
        "currency": {"const": "EUR"},
        "deliveryZone": {"enum": ["CENTER", "OUTSKIRTS"]},
        "paymentReceived": {"type": "boolean"},
        "cookingStarted": {"type": "boolean"},
        "courierAssigned": {"type": "boolean"},
        "delivered": {"type": "boolean"},
        "nextSuggestedCommand": {"enum": ["ReceivePayment", "StartCooking", "AssignCourier", "DeliverOrder", "None"]}
      }
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["orderId", "executedCommand", "emittedEvent", "currentStatus", "policyName", "suggestedNextCommand", "explanation", "board"],
      "properties": {
        "orderId": {"$ref": "#/$defs/uuid"},
        "executedCommand": {"type": "string", "minLength": 1},
        "emittedEvent": {"type": "string", "minLength": 1},
        "currentStatus": {"$ref": "#/$defs/status"},
        "policyName": {"type": "string", "minLength": 1},
        "suggestedNextCommand": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1},
        "board": {"$ref": "#/$defs/board"}
      }
    }
  }
}
